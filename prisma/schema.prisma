generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per paid order: destination province vs. EHF actually charged.
// Powers the remittance report. Deliberately stores NO customer PII —
// only the destination province/country and fee math.
model EhfOrderRecord {
  id                  String   @id // `${shop}:${orderId}`
  shop                String
  orderId             String
  orderName           String?
  processedAt         DateTime
  destinationCountry  String?
  destinationProvince String?
  chargedCents        Int      @default(0)
  expectedCents       Int?
  chargedLinesJson    String   @default("[]")
  expectedLinesJson   String   @default("[]")
  mismatch            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  /// "pos" or "online", from Shopify's order source_name. Nullable on
  /// purpose: records written before channel capture genuinely don't know,
  /// and defaulting them to "online" would be inventing history.
  channel             String?

  @@index([shop, processedAt])
}

// Privacy-preserving daily page view counts for public pages (/, /rates).
// No IPs, no cookies, no user agents stored — just date/path/src tallies.
model PageViewDaily {
  id        String   @id // `${date}:${path}:${src}`
  date      String
  path      String
  src       String   @default("direct")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([path, date])
}

// "Tell me when the rates change" list from /rates. CASL: express opt-in
// only (the visitor types the address and submits), every mail must carry
// the unsubscribe link built from `unsubscribeToken` plus Synorai's mailing
// address. No name, no company, no IP — the address is the whole record.
model RateAlertSubscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  src              String    @default("direct")
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([unsubscribedAt])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}